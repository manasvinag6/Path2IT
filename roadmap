/* =========================
   GLOBAL
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Inter", sans-serif;
    background: #07111f;
    color: #f4f7fb;
    line-height: 1.6;
}

a {
    text-decoration: none;
    color: inherit;
}

button {
    font-family: inherit;
    cursor: pointer;
}


/* =========================
   NAVBAR
========================= */

.navbar {
    height: 75px;
    padding: 0 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;

    border-bottom: 1px solid rgba(255,255,255,0.08);

    background: rgba(7,17,31,0.9);

    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(15px);
}

.logo {
    font-size: 21px;
    font-weight: 800;
}

.logo-icon {
    color: #35d0ba;
    margin-right: 7px;
}

.navbar nav {
    display: flex;
    gap: 35px;
}

.navbar nav a {
    color: #9aa9bc;
    font-size: 14px;
    transition: 0.3s;
}

.navbar nav a:hover {
    color: #35d0ba;
}

.profile-btn {
    border: 1px solid #314256;
    background: transparent;
    color: white;
    padding: 10px 18px;
    border-radius: 8px;
}


/* =========================
   HERO
========================= */

.hero {
    min-height: 650px;

    padding: 100px 8%;

    display: grid;
    grid-template-columns: 1.2fr 0.8fr;

    align-items: center;
    gap: 80px;

    background:
        radial-gradient(
            circle at 10% 20%,
            rgba(53,208,186,0.12),
            transparent 30%
        );
}

.hero-content {
    max-width: 700px;
}

.badge {
    display: inline-block;

    padding: 8px 14px;

    border: 1px solid rgba(53,208,186,0.3);

    border-radius: 30px;

    color: #35d0ba;

    font-size: 13px;

    margin-bottom: 25px;
}

.hero h1 {
    font-size: clamp(45px, 6vw, 78px);
    line-height: 1.05;

    letter-spacing: -3px;

    margin-bottom: 25px;
}

.hero h1 span {
    color: #35d0ba;
}

.hero p {
    color: #9aa9bc;
    max-width: 650px;
    font-size: 17px;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    margin-top: 35px;
}

.primary-btn {
    background: #35d0ba;
    color: #04110f;

    border: none;

    padding: 14px 22px;

    border-radius: 8px;

    font-weight: 700;

    transition: 0.3s;
}

.primary-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(53,208,186,0.2);
}

.secondary-btn {
    padding: 14px 22px;

    border-radius: 8px;

    border: 1px solid #314256;

    background: transparent;

    color: white;
}


/* =========================
   HERO CARD
========================= */

.hero-card {
    background: #0c1929;

    border: 1px solid #1e3145;

    border-radius: 18px;

    padding: 30px;

    box-shadow: 0 25px 60px rgba(0,0,0,0.3);
}

.card-header {
    display: flex;
    justify-content: space-between;

    margin-bottom: 15px;

    font-size: 14px;
}

.progress-text {
    color: #35d0ba;
    font-weight: 700;
}

.progress-bar {
    height: 7px;

    background: #1b2a3d;

    border-radius: 10px;

    overflow: hidden;
}

.progress-fill {
    height: 100%;

    width: 0%;

    background: #35d0ba;

    transition: width 0.5s;
}

.journey {
    margin-top: 30px;
}

.journey-item {
    display: flex;
    align-items: center;
    gap: 15px;

    padding: 12px 0;
}

.journey-number {
    width: 38px;
    height: 38px;

    border-radius: 50%;

    display: grid;
    place-items: center;

    background: #142437;

    color: #9aa9bc;

    font-weight: 700;
}

.journey-item.active .journey-number {
    background: #35d0ba;
    color: #061410;
}

.journey-item strong {
    display: block;
}

.journey-item small {
    color: #718198;
}

.journey-line {
    width: 2px;
    height: 20px;

    margin-left: 18px;

    background: #26394f;
}


/* =========================
   STATS
========================= */

.stats {
    padding: 30px 8% 80px;

    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 20px;
}

.stat-card {
    background: #0c1929;

    border: 1px solid #1e3145;

    border-radius: 12px;

    padding: 25px;

    display: flex;
    align-items: center;

    gap: 15px;
}

.stat-icon {
    font-size: 25px;
}

.stat-card h3 {
    font-size: 25px;
}

.stat-card p {
    color: #77869a;
}


/* =========================
   SECTION
========================= */

.roadmap-section,
.skills-section,
.resources {
    padding: 90px 8%;
}

.section-heading {
    max-width: 650px;
    margin: 0 auto 60px;
    text-align: center;
}

.section-label,
.phase {
    color: #35d0ba;

    font-size: 12px;

    font-weight: 800;

    letter-spacing: 2px;
}

.section-heading h2 {
    font-size: 42px;

    margin: 10px 0;
}

.section-heading p {
    color: #7f8da0;
}


/* =========================
   YEAR CARDS
========================= */

.year-card {
    max-width: 1150px;

    margin: 0 auto 35px;

    display: grid;

    grid-template-columns: 120px 1fr;

    background: #0c1929;

    border: 1px solid #1e3145;

    border-radius: 18px;

    overflow: hidden;
}

.year-number {
    background: #101f31;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    font-size: 42px;

    font-weight: 800;

