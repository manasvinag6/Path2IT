/* =========================================
   CAREERFORGE JAVASCRIPT
========================================= */


/* =========================================
   TASK PROGRESS
========================================= */

const tasks = document.querySelectorAll(".task");

tasks.forEach((task, index) => {

    const saved = localStorage.getItem("task-" + index);

    if (saved === "true") {
        task.checked = true;
    }

    task.addEventListener("change", function () {

        localStorage.setItem(
            "task-" + index,
            this.checked
        );

        updateProgress();

    });

});


/* =========================================
   UPDATE OVERALL PROGRESS
========================================= */

function updateProgress() {

    const total = tasks.length;

    const completed =
        document.querySelectorAll(".task:checked").length;

    const percentage =
        Math.round((completed / total) * 100);

    document.getElementById(
        "overallProgress"
    ).textContent = percentage + "%";

    document.getElementById(
        "overallProgressBar"
    ).style.width = percentage + "%";

}


/* =========================================
   START JOURNEY
========================================= */

function startRoadmap() {

    document
        .getElementById("roadmap")
        .scrollIntoView({
            behavior: "smooth"
        });

}


/* =========================================
   DSA TRACKER
========================================= */

let dsaDays =
    parseInt(
        localStorage.getItem("dsaDays")
    ) || 0;

let streak =
    parseInt(
        localStorage.getItem("streak")
    ) || 0;


document.getElementById(
    "dsaDays"
).textContent = dsaDays;

document.getElementById(
    "streak"
).textContent = streak;


/* =========================================
   COMPLETE DSA
========================================= */

function completeDSA() {

    const today =
        new Date().toDateString();

    const lastCompleted =
        localStorage.getItem("lastDSADate");


    if (lastCompleted === today) {

        alert(
            "You have already completed today's DSA problem! 🔥"
        );

        return;

    }


    dsaDays++;

    streak++;


    localStorage.setItem(
        "dsaDays",
        dsaDays
    );

    localStorage.setItem(
        "streak",
        streak
    );

    localStorage.setItem(
        "lastDSADate",
        today
    );


    document.getElementById(
        "dsaDays"
    ).textContent = dsaDays;


    document.getElementById(
        "streak"
    ).textContent = streak;


    alert(
        "Great job! Today's DSA problem is complete 🔥"
    );

}


/* =========================================
   INITIALIZE
========================================= */

updateProgress();
